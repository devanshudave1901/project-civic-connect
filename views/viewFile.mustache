<script>
    document.getElementById("stats").addEventListener("click", function ()
    {
       document.getElementById("statusChangeSection").hidden = false;

    });

    document.getElementById("cancelButton").addEventListener("click", function ()
    {
        document.getElementById("statusChangeSection").hidden = true;

    });
    document.getElementById("edit").addEventListener("click", function() {
        window.location.href = "/edit/{{id}}/?user={{issueUserId}}";
    });

    document.getElementById("delete").addEventListener("click", function() {
        if (confirm("Are you sure you want to delete this issue?")) {
            window.location.href = "/delete/{{id}}/?user={{issueUserId}}";
        }
    });

</script>
</body>
</html>