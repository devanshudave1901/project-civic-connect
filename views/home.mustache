<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <style>
        body{
            background: steelblue;


            height:fit-content;
        }
        #issueTable{
            background: white;
            padding: 20px;
            box-shadow: 20px 20px 60px #bebebe,
            -20px -20px 60px #ffffff;
            border: lightslategray 1px solid;
            border-radius: 20px !important;
        }
        .card {

            border-radius: 50px;
            background: white;
            box-shadow: 10px 10px 10px #bebebe,
            -20px -20px 60px #ffffff;
            /* adding my own design to make it appropriate for my page and bootstrap classes that I feel is appropriate */
            padding: 50px;
            width:115em !important;
            height: 45em !important;
        }
        #appTitle{
            color: whitesmoke ;

        }
    </style>
</head>
<body>
<div class="d-flex justify-content-between align-items-center gap-2 pe-5 mt-3">
    <h1 id="appTitle" class="mb-0 text-5xl flex-grow-1 font-bold text-center">Dashboard</h1>
    <button type="submit" id="addIssueButton" class="btn btn-primary d-inline-block  me-5">Add Issue</button>

</div>

    <div class="card mt-5 mx-auto p-10">
        <h2 class="d-flex justify-content-center align-items-center mb-5"> Issue Tracking </h2>
        <div id="issueTable">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Category</th>
                        <th scope="col">Title</th>
                        <th scope="col">Description</th>
                        <th scope="col">Created Date</th>
                        <th scope="col">Updated Date</th>
                        <th scope="col">Deleted</th>
                        <th scope="col">Status</th>

                    </tr>
                </thead>
                <tbody>
                 {{#tableData}}
                         <tr>
                             <td>{{id}}</td>
                             <td>{{ categoryName}}</td>

                             <td>{{issueTitle}}</td>
                             <td>{{issueDescription}}</td>
                                <td>{{issueCreatedDate}}</td>
                             <td>{{issueUpdatedDate}}</td>
                             <td>{{isDeleted}}</td>
                                <td>{{statusName}}</td>
                         </tr>
                     {{/tableData}}
                </tbody>
            </table>
        </div>

    </div>
<script>
    let addIssueButton = document.getElementById('addIssueButton');

    addIssueButton.addEventListener('click', function() {
        window.location.href = '/registerIssue';
    });
</script>
</body>
</html>