<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <link rel="stylesheet" href="responsive.css">

    <title>Add Comment</title>
</head>
<style>

</style>
<body>
<div class="card  mx-auto">
    <h2 class="d-flex justify-content-center align-items-center">Add Comments</h2>
    <form class="mt-5" action="/submitComment" >
        <div class="container">
            <div class="row mt-3">
                <div class="col">
                    <label for="commentContent" class="form-label">Comment</label>
                    <textarea class="form-control" id="commentContent" name="commentContent" rows="3"></textarea>
                </div>
                <div hidden>
                    <input value="{{issueId}}" name="issueId" />
                    <input value="{{user}}" name="userId" />
                </div>
            </div>
            <button type="submit" id="submitComment" class="btn btn-primary mt-5 w-100">Submit</button>
        </div>
    </form>

</div>
</body>
</html>