<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<style>
    body{
        background: #e0e0e0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }
    /* From Uiverse.io by Codewithvinay */
    .card {

        border-radius: 50px;
        background: #e0e0e0;
        box-shadow: 20px 20px 60px #bebebe,
        -20px -20px 60px #ffffff;
        /* adding my own design to make it appropriate for my page and bootstrap classes that I feel is appropriate */
        padding: 50px;
        width: 30%;
        height: 70%;
    }
</style>
<body>

<div class="card  mx-auto">
    <h2 class="d-flex justify-content-center align-items-center">{{cardHeading}}</h2>
    {{#login}}
        <form class="mt-5 ">
            <div class="mb-3">
                <label for="userEmailAddress" class="form-label">Email Address</label>
                <input type="email"  class="form-control" id="userEmailAddress">
            </div>
            <div class="mb-3">
                <label for="userPassword" class="form-label">Password</label>
                <input type="password"  class="form-control" id="userPassword">
            </div>
            <button type="submit" class="btn btn-primary mt-5 w-100">Submit</button>
            <h6 class="mt-3 text-secondary">Don't have the account? Click here to <a id="registerPageLink" href="register"> Register</a></h6>
        </form>
    {{/login}}
    {{#register}}
        <form class="mt-5 ">
            <div class="container">
                <div class="row mt-3">
                    <div class="col">
                        <label for="userFirstName" class="form-label">First Name</label>
                        <input type="text"  class="form-control" id="userFirstName" required>
                    </div>
                    <div class="col">
                        <label for="userLastName" class="form-label">Last Name</label>
                        <input type="text"  class="form-control" id="userLastName" required>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col">
                        <label for="userEmailAddress" class="form-label">Email Address</label>
                        <input type="email"  class="form-control" id="userEmailAddress" required>
                    </div>
                    <div class="col">
                        <label for="userPhoneNumber" class="form-label">Phone Number</label>
                        <input type="number"  class="form-control" id="userPhoneNumber" required>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col">
                        <label for="userName" class="form-label">Desired Username</label>
                        <input type="text"  class="form-control" id="userName" required>
                    </div>
                    <div class="col">
                        <label for="userPassword" class="form-label">Password</label>
                        <input type="password"  class="form-control" id="userPassword" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-5 w-100">Submit</button>
                <h6 class="mt-3 text-secondary">Already have the account? Click here to <a id="loginPageLink" href="login"> Login</a></h6>
            </div>
        </form>
    {{/register}}
</div>
</body>
</html>