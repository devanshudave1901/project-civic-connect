<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
<!--    <meta name="viewport"-->
<!--          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">-->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="responsive.css">
</head>
<style>

</style>
<body>

<div class="card  mx-auto">
    <h2 class="d-flex justify-content-center align-items-center">{{cardHeading}}</h2>
    {{#login}}
        <form class="mt-5" action="/loginUser">
            <div class="mb-3">
                <label for="userEmailAddress" class="form-label">Email Address</label>
                <input type="email" name="userEmailAddress" class="form-control" id="userEmailAddress" value="{{emailData}}" required>
            </div>
            <div class="mb-3">
                <label for="userPassword" class="form-label">Password</label>
                <input type="password" name="userPassword" class="form-control" id="userPassword" required>
            </div>
            <button type="submit" class="btn btn-primary mt-5 w-100">Submit</button>
            <h6 class="mt-3 text-secondary">Don't have the account? Click here to <a id="registerPageLink" href="register"> Register</a></h6>
        </form>

    {{/login}}
    {{#register}}
        <form class="mt-5" action="/registerTheUser"  >
            <div class="container">
                <div class="row mt-3">
                    <div class="col">
                        <label for="userFirstName" class="form-label">First Name</label>
                        <input type="text" name="userFirstName" class="form-control" id="userFirstName"  value="{{dataForm.userFirstName}}" required>
                    </div>
                    <div class="col">
                        <label for="userLastName" class="form-label">Last Name</label>
                        <input type="text" name="userLastName" class="form-control" id="userLastName" value="{{dataForm.userLastName}}" required>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col">
                        <label for="userEmailAddress" class="form-label">Email Address</label>
                        <input type="email" name="userEmailAddress"  class="form-control" id="userEmailAddress" required>
                    </div>
                    <div class="col">
                        <label for="userPhoneNumber" class="form-label">Phone Number</label>
                        <input type="number" name="userPhoneNumber"  class="form-control" id="userPhoneNumber" value="{{dataForm.userPhoneNumber}}" required>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col">
                        <label for="userName" class="form-label">Desired Username</label>
                        <input type="text"  name="userName" class="form-control" id="userName" value="{{dataForm.userName}}" required>
                    </div>
                    <div class="col">
                        <label for="userPassword" class="form-label">Password</label>
                        <input type="password" name="userPassword"  class="form-control" id="userPassword" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-5 w-100">Submit</button>
                <h6 class="mt-3 text-secondary">Already have the account? Click here to <a id="loginPageLink" href="login"> Login</a></h6>
            </div>
        </form>
    {{/register}}
    {{#accountCreated}}
        <div class="alert alert-success" role="alert">
            Account Created Successfully! Please proceed to Login
        </div>
    {{/accountCreated}}
    {{#errorLogin}}
        <div class="alert alert-danger" role="alert">
           Incorrect email or password. Please try again.
        </div>
    {{/errorLogin}}
</div>
</body>
</html>